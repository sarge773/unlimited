{
  "name": "universal-fetch-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "enable_request_signal",
    "global_fetch_strictly_public"
  ],
  "secrets": {
    "required": ["RELAY_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
